<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- The connector plugin packages Invoklet ships with (build/ConnectorPlugins.targets). Locally the pack output folder
         in an invoklet-plugins checkout; release builds point this source at GitHub Packages. -->
    <add key="invoklet-plugins" value="../invoklet-plugins/artifacts/packages" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="invoklet-plugins">
      <package pattern="invoklet.connector.*" />
    </packageSource>
  </packageSourceMapping>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
