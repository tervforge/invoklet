<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:Invoklet.Windows.Models"
        xmlns:local="using:Invoklet.Windows"
        xmlns:controls="using:Invoklet.TemplatedControls"
        x:Class="Invoklet.Windows.AssemblyExplorerWindow"
        Icon="/Assets/icon.ico"
        Title="Assembly Explorer"
        Width="1100" Height="720"
        MinWidth="600" MinHeight="400"
        CanResize="True"
        Background="{DynamicResource Invoklet.Panel.BackgroundBrush}"
        Foreground="{DynamicResource Invoklet.Text.PrimaryBrush}">

    <Window.DataTemplates>
        <DataTemplate DataType="models:AssemblyTreeNode">
            <StackPanel Orientation="Horizontal" Spacing="6" Opacity="{Binding Opacity}">
                <Grid Width="18" Height="18">
                    <PathIcon controls:ThemeIcon.Key="{Binding IconKey}" Foreground="{Binding IconBrush}" Width="14" Height="14"/>
                    <PathIcon controls:ThemeIcon.Key="{Binding StaticOverlayKey}" IsVisible="{Binding StaticOverlayKey, Converter={x:Static ObjectConverters.IsNotNull}}"
                              Foreground="{DynamicResource Invoklet.Text.PrimaryBrush}"
                              Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <PathIcon controls:ThemeIcon.Key="{Binding AccessOverlayKey}" IsVisible="{Binding AccessOverlayKey, Converter={x:Static ObjectConverters.IsNotNull}}"
                              Foreground="{DynamicResource Invoklet.Text.PrimaryBrush}"
                              Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                </Grid>
                <TextBlock Text="{Binding Text}" FontStyle="{Binding FontStyle}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Location}" VerticalAlignment="Center"
                           IsVisible="{Binding Location, Converter={x:Static ObjectConverters.IsNotNull}}"
                           Foreground="{DynamicResource Invoklet.Text.SecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,Auto,*" Margin="12">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
            <Button Classes="secondary" x:Name="BackButton" IsEnabled="False"
                    ToolTip.Tip="Back" AutomationProperties.Name="Back">
                <PathIcon Data="{DynamicResource Icon.ChevronLeft}" Width="14" Height="14"/>
            </Button>
            <Button Classes="secondary" x:Name="ForwardButton" IsEnabled="False"
                    ToolTip.Tip="Forward" AutomationProperties.Name="Forward">
                <PathIcon Data="{DynamicResource Icon.ChevronRight}" Width="14" Height="14"/>
            </Button>
            <Button Classes="secondary" x:Name="BrowseButton" Content="Browse..." Margin="8,0,0,0"/>
            <Button Classes="secondary" x:Name="SaveCodeButton" IsEnabled="False"
                    ToolTip.Tip="Save the shown code" AutomationProperties.Name="Save Code">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon Data="{DynamicResource Icon.Save}" Width="14" Height="14"/>
                    <TextBlock Text="Save Code..." VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <ComboBox x:Name="LanguageBox" Margin="8,0,0,0" MinWidth="70"
                      ToolTip.Tip="Language" AutomationProperties.Name="Language"/>
            <ComboBox x:Name="VersionBox" MinWidth="110"
                      ToolTip.Tip="C# version the decompiler may use" AutomationProperties.Name="C# version"/>
        </StackPanel>

        <TextBlock x:Name="AssemblyPathBlock" Grid.Row="1" Margin="0,8,0,8"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Invoklet.Text.SecondaryBrush}"/>

        <Grid Grid.Row="2" ColumnDefinitions="320,5,*">

            <!-- ILSpy's search pane above the tree: results show while the box has text. -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto">
                <TextBox x:Name="SearchBox" Grid.Row="0" PlaceholderText="Search types and members"
                         AutomationProperties.Name="Search"/>
                <StackPanel Grid.Row="1" IsVisible="False" x:Name="SearchPanel" Margin="0,4,0,4">
                    <TextBlock x:Name="SearchStatus" Margin="2,0,0,2" FontSize="11"
                               Foreground="{DynamicResource Invoklet.Text.SecondaryBrush}"/>
                    <ListBox x:Name="SearchResults" MaxHeight="280"
                             AutomationProperties.Name="Search results"/>
                </StackPanel>
                <TreeView x:Name="TypeTree" Grid.Row="2" SelectionMode="Single">
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="TreeContextMenu">
                            <MenuItem x:Name="RemoveAssemblyMenuItem" Header="Remove assembly"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="MinHeight" Value="24"/>
                        </Style>
                    </TreeView.Styles>
                </TreeView>

                <!-- ILSpy's analyzer pane: results of "Analyze" (context menu / Ctrl+R). -->
                <Border Grid.Row="3" x:Name="AnalysisPanel" IsVisible="False" Margin="0,6,0,0" Padding="0,4,0,0"
                        BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Invoklet.Separator.BackgroundBrush}">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="AnalysisTitle" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="CloseAnalysisButton" Grid.Column="1" Padding="4"
                                    ToolTip.Tip="Close" AutomationProperties.Name="Close analysis">
                                <PathIcon Data="{DynamicResource Icon.Close}" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                        <CheckBox x:Name="IncludeVirtualCallsBox" IsVisible="False" Margin="0,2,0,0"
                                  Content="Include virtual calls"
                                  ToolTip.Tip="Also count virtual calls of the base and interface members this one overrides or implements — calls that may reach it at run time"/>
                        <TextBlock x:Name="AnalysisStatus" Margin="2,2,0,2" FontSize="11"
                                   Foreground="{DynamicResource Invoklet.Text.SecondaryBrush}"/>
                        <ListBox x:Name="AnalysisResults" MaxHeight="260"
                                 AutomationProperties.Name="Analysis results"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"
                          Background="{DynamicResource Invoklet.Separator.BackgroundBrush}"/>

            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <!-- Document tabs: each with its own page and Back/Forward history. -->
                <ListBox x:Name="DocumentTabs" Grid.Row="0" Margin="0,0,0,4"
                         AutomationProperties.Name="Document tabs"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:AssemblyExplorerWindow+TabHeader">
                            <!-- Grid, not a StackPanel: the title column is capped by MaxWidth and
                                 trimmed, so a long title (Func<T1, ..., T16, TResult>) never pushes
                                 the close button out of the tab. -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" MaxWidth="260"
                                  ToolTip.Tip="{Binding Title}">
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Padding="2" Background="Transparent" BorderThickness="0"
                                        ToolTip.Tip="Close tab" AutomationProperties.Name="Close tab">
                                    <PathIcon Data="{DynamicResource Icon.Close}" Width="8" Height="8"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ContentPresenter x:Name="EditorHost" Grid.Row="1"/>
            </Grid>

        </Grid>

    </Grid>

</Window>
