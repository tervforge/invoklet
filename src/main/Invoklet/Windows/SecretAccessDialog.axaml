<templatedControls:InvokletDialogWindow xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="using:Invoklet.Windows"
                         xmlns:templatedControls="clr-namespace:Invoklet.TemplatedControls"
                         x:Class="Invoklet.Windows.SecretAccessDialog"
                         Icon="/Assets/icon.ico" Title="Secret Store"
                         Background="{DynamicResource Invoklet.Panel.BackgroundBrush}"
                         Foreground="{DynamicResource Invoklet.Text.PrimaryBrush}">
    <local:DialogLayout x:Name="Layout">
        <local:DialogLayout.Actions>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Invoklet.Space.Control}">
                <Button Classes="secondary" Content="Don't Allow" MinWidth="{DynamicResource Invoklet.Size.DialogButton}" Click="Deny_Click" IsCancel="True"/>
                <Button Classes="secondary" Content="Allow Once" MinWidth="{DynamicResource Invoklet.Size.DialogButton}" Click="Once_Click"/>
                <Button Classes="primary" Content="Always Allow" MinWidth="{DynamicResource Invoklet.Size.DialogButton}" Click="Always_Click"/>
            </StackPanel>
        </local:DialogLayout.Actions>
    </local:DialogLayout>
</templatedControls:InvokletDialogWindow>
