<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:templatedControls="clr-namespace:Invoklet.TemplatedControls"
             x:Class="Invoklet.UserControls.EditorTabsControl">

    <UserControl.Styles>

        <!-- Default TabControl lays tab headers out in a WrapPanel, wrapping onto extra rows once
             they no longer fit — but that WrapPanel used to be capped to a single row's height
             (MaxHeight="30"), so once enough tabs were open, rows beyond the first just overlapped
             whatever sits below them instead of being reachable at all (reported by user).
             ItemsPanel swaps that WrapPanel for a plain non-wrapping horizontal StackPanel, and the
             custom Template below wraps it in a horizontally-scrolling ScrollViewer instead — tabs
             that don't fit are reachable by scrolling (wheel/scrollbar/drag), never clipped or
             overlapping. The "+" follows the last tab inside the scrolled strip; the list of all tabs has a column of its own at
             the right, outside it, so no tab ever slides under it (both used to lie over the strip's right end and hide tabs). -->
        <Style Selector="TabControl#FileTabControl">
            <Setter Property="Background" Value="{DynamicResource Invoklet.Editor.BackgroundBrush}"/>
            <Setter Property="Padding"    Value="0"/>
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate TargetType="TabControl">
                    <Border Background="{TemplateBinding Background}">
                        <DockPanel>
                            <Grid Name="PART_StripRow" DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                                <!-- The theme's scroll bar, drawn over the headers, hid half of their names: this one is a thin line at their
                                     foot (style below). The wheel scrolls the strip too, and the tab chosen is brought into view. -->
                                <ScrollViewer Name="PART_TabStripScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              AllowAutoHide="False">
                                    <StackPanel Orientation="Horizontal">
                                        <ItemsPresenter Name="PART_ItemsPresenter"
                                                        ItemsPanel="{TemplateBinding ItemsPanel}"/>
                                        <templatedControls:IconButton Name="PART_AddTab"
                                                                      Width="30" Height="30"
                                                                      Foreground="{DynamicResource Invoklet.Text.SecondaryBrush}"
                                                                      IconData="{DynamicResource Icon.Plus}"
                                                                      ToolTip.Tip="New file"/>
                                    </StackPanel>
                                </ScrollViewer>
                                <templatedControls:IconButton Name="PART_AllTabs" Grid.Column="1"
                                                              Width="30" Height="30"
                                                              Foreground="{DynamicResource Invoklet.Text.SecondaryBrush}"
                                                              IconData="{DynamicResource Icon.ChevronDown}"
                                                              ToolTip.Tip="Show all open tabs"/>
                            </Grid>
                            <ContentPresenter Name="PART_SelectedContentHost"
                                              Content="{TemplateBinding SelectedContent}"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ScrollViewer#PART_TabStripScrollViewer /template/ ScrollBar:horizontal">
            <Setter Property="Height" Value="3"/>
            <Setter Property="MinHeight" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style Selector="ScrollViewer#PART_TabStripScrollViewer /template/ ScrollBar /template/ Thumb">
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="TabControl#FileTabControl > TabItem">
            <Setter Property="Background" Value="{DynamicResource Invoklet.Panel.BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Invoklet.Text.SecondaryBrush}"/>
            <Setter Property="Margin"     Value="0"/>
            <Setter Property="MinHeight"  Value="30"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="TabItem">
                    <Panel>
                        <Border x:Name="TopAccent"
                                Height="1"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                ZIndex="1"/>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Invoklet.Separator.BackgroundBrush}"
                                BorderThickness="0,0,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl#FileTabControl > TabItem:selected /template/ Border#TopAccent">
            <Setter Property="Background" Value="{DynamicResource Invoklet.Tab.AccentBrush}"/>
        </Style>
        <Style Selector="TabControl#FileTabControl > TabItem:selected">
            <Setter Property="Background" Value="{DynamicResource Invoklet.Editor.BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource Invoklet.Text.PrimaryBrush}"/>
        </Style>
        <Style Selector="TabControl#FileTabControl > TabItem:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource Invoklet.Toolbar.Button.HoverBrush}"/>
        </Style>

        <Style Selector="Button.TabClose">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Width"           Value="14"/>
            <Setter Property="Height"          Value="14"/>
            <Setter Property="CornerRadius"    Value="{DynamicResource Invoklet.Radius.Control}"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.TabClose:pointerover">
            <Setter Property="Background" Value="{DynamicResource Invoklet.Toolbar.Button.HoverBrush}"/>
        </Style>
        <Style Selector="TabControl#FileTabControl > TabItem:pointerover Button.TabClose">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="TabControl#FileTabControl > TabItem:selected Button.TabClose">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="TabControl#FileTabControl > TabItem:focus-within Button.TabClose">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Where the close button shows, the status gives way; the tab's tooltip still tells it. -->
        <Style Selector="TabControl#FileTabControl > TabItem:selected Panel.TabStatus">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="TabControl#FileTabControl > TabItem:pointerover Panel.TabStatus">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="TabControl#FileTabControl > TabItem:focus-within Panel.TabStatus">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Dirty indicator — the header's TextBlock lives here,
             not in EditorTabItemControl.axaml: TabHeaderTemplate is fetched from that UserControl's
             own Resources but applied as THIS TabControl's TabItem.HeaderTemplate (see
             EditorTabsControl.AddTabItem), so the realized TextBlock ends up in this control's visual
             tree, where TabItem's own Style above lives — not inside EditorsTabItemControl's (that
             one only ever becomes the TabItem's Content, a sibling of the header, not an ancestor of
             it). A Style scoped to EditorTabItemControl.axaml's own UserControl.Styles would simply
             never match. -->
        <Style Selector="TabControl#FileTabControl TextBlock.dirty">
            <Setter Property="Foreground" Value="{DynamicResource Invoklet.Tab.DirtyBrush}"/>
        </Style>

    </UserControl.Styles>

    <TabControl Name="FileTabControl" Padding="0"/>

</UserControl>
