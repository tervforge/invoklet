<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\connectors\Invoklet.Connectors.Grpc\Invoklet.Connectors.Grpc.csproj" />
    <ProjectReference Include="..\..\connectors\Invoklet.Connectors.Http\Invoklet.Connectors.Http.csproj" />
    <ProjectReference Include="..\..\connectors\Invoklet.Connectors.Postgres\Invoklet.Connectors.Postgres.csproj" />
    <ProjectReference Include="..\..\connectors\Invoklet.Connectors.Sqlite\Invoklet.Connectors.Sqlite.csproj" />
    <ProjectReference Include="..\..\connectors\Invoklet.Connectors.SqlServer\Invoklet.Connectors.SqlServer.csproj" />
    <ProjectReference Include="..\..\core\Invoklet.Plugins.Hosting\Invoklet.Plugins.Hosting.csproj" />
    <ProjectReference Include="..\..\languages\Invoklet.Languages.CSharp\Invoklet.Languages.CSharp.csproj" />
    <ProjectReference Include="..\..\languages\Invoklet.Languages.VB\Invoklet.Languages.VB.csproj" />
  </ItemGroup>
  <Target Name="ReadInvokletProductVersion" BeforeTargets="GetAssemblyVersion">
    <!-- GUI and CLI use the same version for plugin compatibility. The desktop project owns the release version. -->
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)../Invoklet/Invoklet.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="Version" />
    </XmlPeek>
  </Target>
</Project>
