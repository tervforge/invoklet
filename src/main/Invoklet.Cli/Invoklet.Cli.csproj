<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>invoklet</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Invoklet.BuiltIns\Invoklet.BuiltIns.csproj" />
    <ProjectReference Include="..\..\core\Invoklet.Format.MdRun\Invoklet.Format.MdRun.csproj" />
    <!-- Built and copied beside the runner for the scripts to compile against; the runner itself never links it. -->
    <ProjectReference Include="..\..\runtime\Invoklet.Runtime\Invoklet.Runtime.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\languages\Invoklet.Languages.CSharp\Invoklet.Languages.CSharp.csproj" />
    <ProjectReference Include="..\..\languages\Invoklet.Languages.VB\Invoklet.Languages.VB.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Invoklet.Cli.Tests" />
  </ItemGroup>

  <Import Project="../../../build/ConnectorPlugins.targets" />
  <PropertyGroup>
    <InvokletShipConnectors>true</InvokletShipConnectors>
  </PropertyGroup>
  <Import Project="..\..\..\build\BundledPlugins.targets" />
</Project>
