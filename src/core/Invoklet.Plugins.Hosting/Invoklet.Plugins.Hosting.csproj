<Project Sdk="Microsoft.NET.Sdk">
  <!-- The host side of plugins: finding manifests, loading each plugin in its own AssemblyLoadContext, registering its roles through
       the handlers the application supplies, and the immutable record of what one start loaded. Used by the application and the CLI;
       a plugin never references it. -->
  <PropertyGroup>
    <RootNamespace>Invoklet.Plugins.Hosting</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Invoklet.Plugins\Invoklet.Plugins.csproj" />
    <ProjectReference Include="..\Invoklet.Contracts\Invoklet.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Invoklet.NonUI.Tests" />
  </ItemGroup>
</Project>
