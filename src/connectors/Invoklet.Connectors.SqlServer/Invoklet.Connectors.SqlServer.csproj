<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <None Update="invoklet-plugin.json" CopyToPublishDirectory="PreserveNewest" Condition="'$(InvokletConnectorPackage)' == '$(MSBuildProjectName)'" />
  </ItemGroup>
  <!-- SQL Server connections: the provider's package brings Microsoft.Data.SqlClient and its design-time services, and nothing of any other database. -->
  <PropertyGroup>
    <RootNamespace>Invoklet.Connectors.SqlServer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Invoklet.NonUI.Tests" />
    <InternalsVisibleTo Include="Invoklet.Connectors.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Invoklet.Connectors.EfCore\Invoklet.Connectors.EfCore.csproj" />
  </ItemGroup>
</Project>
