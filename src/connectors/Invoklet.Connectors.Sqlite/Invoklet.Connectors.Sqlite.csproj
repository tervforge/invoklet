<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <None Update="invoklet-plugin.json" CopyToPublishDirectory="PreserveNewest" Condition="'$(InvokletConnectorPackage)' == '$(MSBuildProjectName)'" />
  </ItemGroup>
  <!-- SQLite connections: the provider's package brings Microsoft.Data.Sqlite and its design-time services, and nothing of any other database. -->
  <PropertyGroup>
    <RootNamespace>Invoklet.Connectors.Sqlite</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Invoklet.NonUI.Tests" />
    <InternalsVisibleTo Include="Invoklet.Connectors.Tests" />
    <InternalsVisibleTo Include="Invoklet.Runtime.UI.Tests" />
    <InternalsVisibleTo Include="Invoklet.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Invoklet.Connectors.EfCore\Invoklet.Connectors.EfCore.csproj" />
  </ItemGroup>
  <Import Project="../../../build/EfCoreDesign.props" />
</Project>
