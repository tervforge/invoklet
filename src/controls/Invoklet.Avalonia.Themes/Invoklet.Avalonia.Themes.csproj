<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Invoklet.Avalonia.Themes</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Controls.DataGrid" />
        <PackageReference Include="TextMateSharp.Grammars" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Themes/*.json" LogicalName="Themes/%(Filename)%(Extension)" />
        <EmbeddedResource Include="Metrics.json" LogicalName="Metrics.json" />
    </ItemGroup>

</Project>
