<Project>
  <!-- The connectors Invoklet ships with. They are built in the invoklet-plugins repository and taken here as NuGet packages: from
       InvokletConnectorPackages, by default the artifacts/packages folder of an invoklet-plugins checkout beside this one
       (`dotnet pack PluginPackages.slnx -c Release -o artifacts/packages` there), read straight from the .nupkg files so a repacked
       version is never stale; otherwise restored from the invoklet-plugins source of nuget.config, which release builds point at
       GitHub Packages. Each package's plugin/ folder is staged, without the native libraries of other operating systems when the
       build has a runtime identifier; the plugin packager then writes bundled.json. Without the packages Invoklet builds with no
       bundled connector; set InvokletShipConnectors to require them. -->
  <PropertyGroup>
    <InvokletConnectorsVersion>1.0.0</InvokletConnectorsVersion>
    <InvokletConnectorPackages Condition="'$(InvokletConnectorPackages)' == ''">$(MSBuildThisFileDirectory)../../invoklet-plugins/artifacts/packages</InvokletConnectorPackages>
    <_InvokletLocalConnectors>$([System.IO.Path]::GetFullPath('$(InvokletConnectorPackages)'))</_InvokletLocalConnectors>
  </PropertyGroup>
  <ItemGroup>
    <InvokletConnectorPackage Include="invoklet.connector.efcore" PluginPath="library/invoklet.connector.efcore" />
    <InvokletConnectorPackage Include="invoklet.connector.http" PluginPath="connection/invoklet.connector.http" />
    <InvokletConnectorPackage Include="invoklet.connector.grpc" PluginPath="connection/invoklet.connector.grpc" />
    <InvokletConnectorPackage Include="invoklet.connector.sqlite" PluginPath="connection/invoklet.connector.sqlite" />
    <InvokletConnectorPackage Include="invoklet.connector.postgres" PluginPath="connection/invoklet.connector.postgres" />
    <InvokletConnectorPackage Include="invoklet.connector.sqlserver" PluginPath="connection/invoklet.connector.sqlserver" />
  </ItemGroup>
  <!-- Local packages are used when the folder holds any of them; then all six must be there. -->
  <PropertyGroup>
    <_InvokletUseLocalConnectors Condition="Exists('$(_InvokletLocalConnectors)/invoklet.connector.efcore.$(InvokletConnectorsVersion).nupkg') or Exists('$(_InvokletLocalConnectors)/invoklet.connector.http.$(InvokletConnectorsVersion).nupkg') or Exists('$(_InvokletLocalConnectors)/invoklet.connector.grpc.$(InvokletConnectorsVersion).nupkg') or Exists('$(_InvokletLocalConnectors)/invoklet.connector.sqlite.$(InvokletConnectorsVersion).nupkg') or Exists('$(_InvokletLocalConnectors)/invoklet.connector.postgres.$(InvokletConnectorsVersion).nupkg') or Exists('$(_InvokletLocalConnectors)/invoklet.connector.sqlserver.$(InvokletConnectorsVersion).nupkg')">true</_InvokletUseLocalConnectors>
    <InvokletShipConnectors Condition="'$(InvokletShipConnectors)' == '' and '$(_InvokletUseLocalConnectors)' == 'true'">true</InvokletShipConnectors>
  </PropertyGroup>
  <Target Name="CheckLocalConnectorPackages" BeforeTargets="Restore;_GenerateRestoreGraph;Build"
          Condition="'$(InvokletShipConnectors)' == 'true' and '$(_InvokletUseLocalConnectors)' == 'true'">
    <ItemGroup>
      <_InvokletMissingLocalConnector Include="@(InvokletConnectorPackage->'%(Identity).$(InvokletConnectorsVersion).nupkg')"
                                      Condition="!Exists('$(_InvokletLocalConnectors)/%(Identity).$(InvokletConnectorsVersion).nupkg')" />
    </ItemGroup>
    <Error Condition="'@(_InvokletMissingLocalConnector)' != ''"
           Text="$(_InvokletLocalConnectors) holds some connector packages but not: @(_InvokletMissingLocalConnector, ', '). Pack all of invoklet-plugins (PluginPackages.slnx) at version $(InvokletConnectorsVersion), or empty the folder." />
  </Target>
  <ItemGroup Condition="'$(InvokletShipConnectors)' == 'true' and '$(_InvokletUseLocalConnectors)' != 'true'">
    <PackageDownload Include="@(InvokletConnectorPackage)" Version="[$(InvokletConnectorsVersion)]" />
  </ItemGroup>
  <Target Name="StageConnectorPluginSources">
    <PropertyGroup>
      <_ConnectorSourceDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)connector-packages'))</_ConnectorSourceDirectory>
      <_ConnectorUnpackedDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(IntermediateOutputPath)connector-nupkgs'))</_ConnectorUnpackedDirectory>
      <InvokletBundledPluginsSource>$(_ConnectorSourceDirectory)</InvokletBundledPluginsSource>
      <!-- runtimes/<rid> folders a build for $(RuntimeIdentifier) can load: its own, its operating system's and unix for macOS and Linux. -->
      <_ConnectorRuntimeOs>$(RuntimeIdentifier.Split('-')[0])</_ConnectorRuntimeOs>
      <_ConnectorRuntimes>;$(RuntimeIdentifier);$(_ConnectorRuntimeOs);</_ConnectorRuntimes>
      <_ConnectorRuntimes Condition="'$(_ConnectorRuntimeOs)' != 'win'">$(_ConnectorRuntimes)unix;</_ConnectorRuntimes>
    </PropertyGroup>
    <RemoveDir Directories="$(_ConnectorSourceDirectory);$(_ConnectorUnpackedDirectory)" />
    <Unzip Condition="'$(_InvokletUseLocalConnectors)' == 'true'"
           SourceFiles="@(InvokletConnectorPackage->'$(_InvokletLocalConnectors)/%(Identity).$(InvokletConnectorsVersion).nupkg')"
           DestinationFolder="$(_ConnectorUnpackedDirectory)/%(InvokletConnectorPackage.Identity)" />
    <ItemGroup>
      <_ConnectorPackageFolder Condition="'$(_InvokletUseLocalConnectors)' == 'true'"
                               Include="@(InvokletConnectorPackage->'$(_ConnectorUnpackedDirectory)/%(Identity)/plugin')" />
      <_ConnectorPackageFolder Condition="'$(_InvokletUseLocalConnectors)' != 'true'"
                               Include="@(InvokletConnectorPackage->'$(NuGetPackageRoot)%(Identity)/$(InvokletConnectorsVersion)/plugin')" />
      <_ConnectorPayloadFile Include="%(_ConnectorPackageFolder.Identity)/**" PluginPath="%(_ConnectorPackageFolder.PluginPath)" />
      <_ConnectorPayloadFile Remove="@(_ConnectorPayloadFile)"
                             Condition="'$(RuntimeIdentifier)' != '' and $([System.String]::Copy('%(RecursiveDir)').Replace('\', '/').StartsWith('runtimes/'))
                                        and !$(_ConnectorRuntimes.Contains(';$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/').Split('/')[1]);'))" />
    </ItemGroup>
    <Error Condition="!Exists('%(_ConnectorPackageFolder.Identity)')" Text="The connector package has no plugin folder: %(_ConnectorPackageFolder.Identity)" />
    <Copy SourceFiles="@(_ConnectorPayloadFile)" DestinationFiles="@(_ConnectorPayloadFile->'$(_ConnectorSourceDirectory)/%(PluginPath)/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
