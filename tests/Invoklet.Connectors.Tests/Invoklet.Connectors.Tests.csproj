<Project Sdk="Microsoft.NET.Sdk">
  <!-- The unit tests of the connection drivers; none reaches a database server (those are in Invoklet.Connectors.IntegrationTests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Invoklet.Connectors.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" VersionOverride="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\main\Invoklet\Invoklet.csproj" />
    <ProjectReference Include="../../src/connectors/Invoklet.Connectors.Http/Invoklet.Connectors.Http.csproj" />
    <ProjectReference Include="../../src/connectors/Invoklet.Connectors.Grpc/Invoklet.Connectors.Grpc.csproj" />
    <ProjectReference Include="../../src/connectors/Invoklet.Connectors.Sqlite/Invoklet.Connectors.Sqlite.csproj" />
    <ProjectReference Include="../../src/connectors/Invoklet.Connectors.Postgres/Invoklet.Connectors.Postgres.csproj" />
    <ProjectReference Include="../../src/connectors/Invoklet.Connectors.SqlServer/Invoklet.Connectors.SqlServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
