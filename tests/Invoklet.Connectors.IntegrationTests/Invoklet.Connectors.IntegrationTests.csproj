<Project Sdk="Microsoft.NET.Sdk">
  <!-- Real SQLite files, provider reverse engineering and compiled scripts. Server tests require INVOKLET_TEST_* variables.
       Built with the solution but not run when CI is set; see CONTRIBUTING.md for local execution. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject Condition="'$(CI)' == 'true'">false</IsTestProject>
    <RootNamespace>Invoklet.Connectors.IntegrationTests</RootNamespace>
    <InvokletPluginSourceTargets>StageConnectorPluginSources</InvokletPluginSourceTargets>
    <InvokletBundledPluginsBuildSubdirectory>connector-fixtures</InvokletBundledPluginsBuildSubdirectory>
    <InvokletConnectorBuildReferences>false</InvokletConnectorBuildReferences>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" VersionOverride="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- A gRPC server with server reflection, on a loopback port, for the gRPC connection's tests. -->
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Protobuf Include="Connectors.Grpc\inventory.proto" GrpcServices="Server" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\main\Invoklet\Invoklet.csproj" />
    <ProjectReference Include="../../src/connectors/Invoklet.Connectors.Http/Invoklet.Connectors.Http.csproj" />
    <ProjectReference Include="../../src/connectors/Invoklet.Connectors.Grpc/Invoklet.Connectors.Grpc.csproj" />
    <ProjectReference Include="../../src/connectors/Invoklet.Connectors.Sqlite/Invoklet.Connectors.Sqlite.csproj" />
    <ProjectReference Include="../fixtures/plugins/SampleHttpConnector/SampleHttpConnector.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/plugins/SampleHttpConnector/invoklet-plugin.json"
          Link="sample-http-connector.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\connectors\Invoklet.Connectors.Postgres\Invoklet.Connectors.Postgres.csproj" />
    <ProjectReference Include="..\..\src\connectors\Invoklet.Connectors.SqlServer\Invoklet.Connectors.SqlServer.csproj" />
  </ItemGroup>
  <Import Project="../../build/ConnectorPlugins.targets" />
  <Import Project="../../build/BundledPlugins.targets" />
</Project>
